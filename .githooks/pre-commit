#!/bin/sh
set -eu

if ! staged_source=$(git show :pascalscript.c); then
    printf '%s\n' 'Unable to read staged pascalscript.c.' >&2
    exit 1
fi

if printf '%s\n' "$staged_source" |
    grep -Eq '^[[:space:]]*#[[:space:]]*define[[:space:]]+DEBUG_SOURCE([[:space:]]|$)'; then
    printf '%s\n' 'Commit rejected: pascalscript.c defines DEBUG_SOURCE.' >&2
    exit 1
fi

staged_files=$(mktemp)
trap 'rm -f "$staged_files"' EXIT

if ! git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' > "$staged_files"; then
    printf '%s\n' 'Unable to list staged C source and header files.' >&2
    exit 1
fi

formatting_changed=0
while IFS= read -r file; do
    if ! before=$(git hash-object -- "$file"); then
        printf 'Commit rejected: unable to read %s before formatting.\n' "$file" >&2
        exit 1
    fi

    if ! clang-format -i -- "$file"; then
        printf 'Commit rejected: clang-format failed for %s.\n' "$file" >&2
        exit 1
    fi

    if ! after=$(git hash-object -- "$file"); then
        printf 'Commit rejected: unable to read %s after formatting.\n' "$file" >&2
        exit 1
    fi

    if [ "$before" != "$after" ]; then
        printf 'clang-format changed %s; review and stage the formatting.\n' "$file" >&2
        formatting_changed=1
    fi
done < "$staged_files"

if [ "$formatting_changed" -ne 0 ]; then
    printf '%s\n' 'Commit rejected: clang-format changed staged files; review and stage the formatting.' >&2
    exit 1
fi
